# Copy to apps/web/.env.local for local development. Never commit real values.
#
# RULE: anything prefixed NEXT_PUBLIC_ is inlined into the static JS bundle and is
# visible to every visitor. Secrets must NEVER use that prefix.

# --- Public build config (GitHub: Settings > Secrets and variables > Actions > Variables) ---
# Canonical site URL, used for metadata and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sub-path the site is served from. Leave empty when using a custom domain;
# set to /devcity when serving from <user>.github.io/devcity.
NEXT_PUBLIC_BASE_PATH=
# GitHub user whose repos the "My Repos" layer shows.
NEXT_PUBLIC_GITHUB_USERNAME=joeykwispel
# Optional: URL of the Cloudflare Worker in apps/proxy, which holds a server-side GitHub token
# and caches responses (e.g. https://devcity-github-proxy.<account>.workers.dev).
# Empty = visitors call GitHub directly with their own 60 requests/hour.
NEXT_PUBLIC_GITHUB_PROXY_URL=

# --- Secrets (GitHub: Settings > Secrets and variables > Actions > Secrets) ---
# Fine-grained PAT, read-only public repo access. Used ONLY at build time by
# scripts/build-data.ts to raise the API limit; it never reaches the browser.
# (GitHub reserves the GITHUB_ prefix for secret names, hence GH_.)
GH_DATA_TOKEN=

# --- Proxy deploy (only if you use apps/proxy; GitHub Actions secrets) ---
# CLOUDFLARE_API_TOKEN   API token with "Edit Cloudflare Workers" permission
# CLOUDFLARE_ACCOUNT_ID  Your Cloudflare account id
# GH_PROXY_TOKEN         Read-only fine-grained PAT the proxy uses (can be the same as GH_DATA_TOKEN)
# For local proxy development put GITHUB_TOKEN in apps/proxy/.dev.vars (see .dev.vars.example).
